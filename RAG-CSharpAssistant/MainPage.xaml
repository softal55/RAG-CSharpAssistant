<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RAG_CSharpAssistant.Models"
             x:Class="RAG_CSharpAssistant.MainPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5EFE6">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          RowSpacing="0"
          ColumnSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="20,20,16,12"
              ColumnDefinitions="56,*,56"
              BackgroundColor="#F5EFE6">
            <Label Grid.Column="1"
                   Text="C# Assistant"
                   TextColor="#2D2D2D"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            <Border Grid.Column="2"
                    WidthRequest="44"
                    HeightRequest="44"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.12"
                            Radius="10"
                            Offset="0,3" />
                </Border.Shadow>
                <Label Text="&#x2699;"
                       FontSize="20"
                       TextColor="#2D2D2D"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Content: full-height empty state OR chat list -->
        <Grid Grid.Row="1">
            <Grid x:Name="EmptyState"
                  BackgroundColor="#F5EFE6"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill"
                  RowDefinitions="0.22*,Auto,Auto,Auto,Auto,0.35*">

                <Image Grid.Row="1"
                       Source="csharp_logo.png"
                       HeightRequest="220"
                       WidthRequest="220"
                       HorizontalOptions="Center"
                       Margin="0,20,0,10"
                       Aspect="AspectFit"
                       Scale="1.05">
                    <Image.Shadow>
                        <Shadow Brush="#6C63FF"
                                Opacity="0.25"
                                Radius="40"
                                Offset="0,20" />
                    </Image.Shadow>
                </Image>

                <Label Grid.Row="2"
                       Text="Ask anything about C# and .NET"
                       FontSize="16"
                       TextColor="#6A6A6A"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,10,0,18" />

                <HorizontalStackLayout Grid.Row="3"
                                       HorizontalOptions="Center"
                                       Spacing="10"
                                       Margin="0,0,0,20"
                                       VerticalOptions="Center">
                    <BoxView WidthRequest="50"
                             HeightRequest="1"
                             Color="#E0D6C8"
                             VerticalOptions="Center" />
                    <Label Text="✦"
                           FontSize="14"
                           TextColor="#A58FE0"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                    <BoxView WidthRequest="50"
                             HeightRequest="1"
                             Color="#E0D6C8"
                             VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Row="4"
                                     Spacing="8"
                                     Padding="20,0">
                    <Border StrokeThickness="0"
                            BackgroundColor="#FFFFFF"
                            Padding="18"
                            Margin="0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.06"
                                    Radius="18"
                                    Offset="0,6" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&lt;/&gt;"
                                   TextColor="#6C63FF"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Explain async/await in C#"
                                   Margin="12,0"
                                   TextColor="#2D2D2D"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="18"
                                   TextColor="#999999"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0"
                            BackgroundColor="#FFFFFF"
                            Padding="18"
                            Margin="0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.06"
                                    Radius="18"
                                    Offset="0,6" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&lt;/&gt;"
                                   TextColor="#6C63FF"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="What is the difference between ref and out in C#?"
                                   Margin="12,0"
                                   TextColor="#2D2D2D"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="18"
                                   TextColor="#999999"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border StrokeThickness="0"
                            BackgroundColor="#FFFFFF"
                            Padding="18"
                            Margin="0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="22" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000"
                                    Opacity="0.06"
                                    Radius="18"
                                    Offset="0,6" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&lt;/&gt;"
                                   TextColor="#6C63FF"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Explain dependency injection in .NET."
                                   Margin="12,0"
                                   TextColor="#2D2D2D"
                                   FontSize="15"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="18"
                                   TextColor="#999999"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Image Grid.Row="5"
                       Source="waves.svg"
                       Aspect="AspectFit"
                       VerticalOptions="End"
                       HorizontalOptions="Fill"
                       Margin="0,8,0,0"
                       Opacity="0.65"
                       HeightRequest="96" />
            </Grid>

            <CollectionView x:Name="ChatList"
                            IsVisible="False"
                            ItemsSource="{Binding Messages}"
                            BackgroundColor="Transparent"
                            VerticalOptions="Fill"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Grid Padding="16,6"
                              HorizontalOptions="Fill"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="0">
                            <!-- User bubble -->
                            <Grid Grid.Row="0"
                                  IsVisible="{Binding IsUser}"
                                  ColumnDefinitions="*,Auto"
                                  HorizontalOptions="Fill">
                                <Border Grid.Column="1"
                                        Padding="16,14"
                                        BackgroundColor="#6C63FF"
                                        StrokeThickness="0"
                                        MaximumWidthRequest="{Binding BindingContext.MaxBubbleWidth, Source={x:Reference Page}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20,20,6,20" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#6C63FF"
                                                Opacity="0.28"
                                                Radius="12"
                                                Offset="0,4" />
                                    </Border.Shadow>
                                    <Label Text="{Binding Text}"
                                           TextColor="White"
                                           FontSize="16"
                                           LineHeight="1.4" />
                                </Border>
                            </Grid>
                            <!-- Assistant bubble -->
                            <Grid Grid.Row="1"
                                  IsVisible="{Binding IsBot}"
                                  ColumnDefinitions="Auto,*"
                                  HorizontalOptions="Fill">
                                <Border Grid.Column="0"
                                        Padding="16,14"
                                        BackgroundColor="White"
                                        StrokeThickness="0"
                                        MaximumWidthRequest="{Binding BindingContext.MaxBubbleWidth, Source={x:Reference Page}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20,20,20,6" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black"
                                                Opacity="0.1"
                                                Radius="14"
                                                Offset="0,4" />
                                    </Border.Shadow>
                                    <Label Text="{Binding Text}"
                                           TextColor="#2D2D2D"
                                           FontSize="16"
                                           LineHeight="1.4" />
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Thinking -->
        <Label Grid.Row="2"
               Text="Thinking..."
               TextColor="#A58FE0"
               FontAttributes="Italic"
               FontSize="14"
               Margin="20,4,20,8"
               IsVisible="{Binding IsGenerating}" />

        <!-- Input (floating bar) -->
        <Grid Grid.Row="3"
              Padding="16,10"
              BackgroundColor="Transparent">
            <Border StrokeThickness="0"
                    BackgroundColor="#FFFFFF"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="30" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Opacity="0.08"
                            Radius="25"
                            Offset="0,8" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,60"
                      ColumnSpacing="8">
                    <Entry Placeholder="Ask a C# question..."
                           TextColor="#2D2D2D"
                           PlaceholderColor="#9E9E9E"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           Text="{Binding InputText}"
                           IsEnabled="{Binding IsInputEnabled}"
                           ReturnCommand="{Binding SendCommand}" />
                    <Button Grid.Column="1"
                            BackgroundColor="#6C63FF"
                            CornerRadius="30"
                            WidthRequest="50"
                            HeightRequest="50"
                            Text="➤"
                            FontSize="18"
                            TextColor="White"
                            BorderWidth="0"
                            Padding="0"
                            VerticalOptions="Center"
                            Command="{Binding SendCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
